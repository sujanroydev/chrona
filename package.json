{
  "name": "chrona",
  "version": "0.2.1",
  "private": true,
  "description": "A lightweight Windows laptop activity tracker.",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "koffi": "^2.14.0"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "in.sujanroy.chrona",
    "productName": "Chrona",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    }
  }
}
